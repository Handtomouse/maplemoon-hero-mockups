{%- comment -%} MapleMoon Password Page (pre-launch) {%- endcomment -%}

<style>
  .mm-password { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 48px 24px; background: #F0EDDF; color: #1E4366; font-family: 'Neue Haas Grotesk Display Pro', 'Inter', sans-serif; text-align: center; }
  .mm-password__logo { width: 64px; height: auto; opacity: 0.6; margin-bottom: 32px; }
  .mm-password__title { font-family: 'P22 Mackinac Pro', Georgia, serif; font-size: 2rem; font-weight: 400; margin: 0 0 8px; }
  .mm-password__message { font-size: 0.95rem; font-weight: 300; opacity: 0.6; max-width: 400px; line-height: 1.6; margin: 0 0 32px; }
  .mm-password__form { display: flex; gap: 0; max-width: 360px; width: 100%; }
  .mm-password__input { flex: 1; padding: 12px 20px; border: 1.5px solid rgba(30,67,102,0.15); border-right: none; border-radius: 50px 0 0 50px; background: transparent; color: #1E4366; font-family: inherit; font-size: 0.85rem; min-height: 48px; outline: none; }
  .mm-password__input:focus { border-color: #1E4366; }
  .mm-password__btn { padding: 12px 24px; border: 1.5px solid rgba(30,67,102,0.15); border-radius: 0 50px 50px 0; background: #1E4366; color: #F0EDDF; font-family: inherit; font-size: 0.8rem; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; cursor: pointer; min-height: 48px; transition: opacity 0.2s; }
  .mm-password__btn:hover { opacity: 0.85; }
  .mm-password__login { margin-top: 24px; font-size: 0.75rem; font-weight: 300; opacity: 0.4; }
  .mm-password__login a { color: #1E4366; text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 768px) { .mm-password__title { font-size: 2.5rem; } .mm-password__logo { width: 80px; } }
</style>

<section class="mm-password">
  {%- if section.settings.logo_image != blank -%}
    <img src="{{ section.settings.logo_image | image_url: width: 160 }}" alt="{{ shop.name }}" class="mm-password__logo" width="80" height="80" loading="eager" decoding="async">
  {%- endif -%}

  <h1 class="mm-password__title">{{ section.settings.title | default: 'Coming Soon' }}</h1>
  <p class="mm-password__message">{{ section.settings.message | default: 'Something good is being made. Leave your email and we will let you know when we are ready.' }}</p>

  {%- comment -%} Newsletter signup or password form — depends on store setup {%- endcomment -%}
  <form class="mm-password__form" action="#" method="post">
    <input class="mm-password__input" type="email" placeholder="Your email" aria-label="Email address" required>
    <button class="mm-password__btn" type="submit">Notify Me</button>
  </form>

  <p class="mm-password__login">
    Store owner? <a href="/password">Enter password</a>
  </p>
</section>

{% schema %}
{
  "name": "Password Page",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "logo_image", "label": "Logo" },
    { "type": "text", "id": "title", "label": "Title", "default": "Coming Soon" },
    { "type": "textarea", "id": "message", "label": "Message", "default": "Something good is being made. Leave your email and we will let you know when we are ready." }
  ]
}
{% endschema %}
