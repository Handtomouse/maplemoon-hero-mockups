{%- comment -%}
  MapleMoon 404 Page
  Minimal, on-brand. Carob wordmark watermark, friendly message, shop CTA.
{%- endcomment -%}

<style>
  .mm-404 {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 80vh;
    text-align: center;
    padding: 64px 24px;
    background: var(--mm404-bg, #F0EDDF);
    color: var(--mm404-text, #1E4366);
    font-family: 'Neue Haas Grotesk Display Pro', 'Inter', 'Helvetica Neue', sans-serif;
    position: relative;
    overflow: hidden;
  }
  .mm-404__watermark {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 0;
  }
  .mm-404__watermark img {
    width: 70%;
    max-width: 600px;
    opacity: 0.06;
    filter: sepia(1) saturate(2) hue-rotate(-10deg) brightness(0.85);
  }
  .mm-404__code {
    font-family: 'P22 Mackinac Pro', Georgia, serif;
    font-size: 6rem;
    font-weight: 400;
    opacity: 0.12;
    line-height: 1;
    margin: 0 0 8px;
    position: relative;
    z-index: 1;
  }
  .mm-404__title {
    font-family: 'P22 Mackinac Pro', Georgia, serif;
    font-size: 1.8rem;
    font-weight: 400;
    margin: 0 0 12px;
    position: relative;
    z-index: 1;
    letter-spacing: 0.03em;
  }
  .mm-404__message {
    font-size: 0.95rem;
    font-weight: 300;
    opacity: 0.6;
    max-width: 400px;
    line-height: 1.6;
    margin: 0 0 32px;
    position: relative;
    z-index: 1;
  }
  .mm-404__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--mm404-text, #1E4366);
    color: var(--mm404-text, #1E4366);
    background: transparent;
    border-radius: 50px;
    padding: 14px 40px;
    min-height: 48px;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.3s, color 0.3s;
    position: relative;
    z-index: 1;
  }
  .mm-404__cta:hover {
    background: var(--mm404-text, #1E4366);
    color: var(--mm404-bg, #F0EDDF);
  }
  .mm-404__cta:focus-visible {
    outline: 2px solid var(--mm404-text, #1E4366);
    outline-offset: 4px;
  }
  .mm-404__back {
    display: inline-block;
    margin-top: 16px;
    font-size: 0.8rem;
    font-weight: 300;
    color: var(--mm404-text, #1E4366);
    opacity: 0.4;
    text-decoration: none;
    transition: opacity 0.2s;
    position: relative;
    z-index: 1;
  }
  .mm-404__back:hover { opacity: 0.7; }
  @media (prefers-reduced-motion: reduce) {
    .mm-404, .mm-404 * { transition: none !important; }
  }
  @media (min-width: 768px) {
    .mm-404__code { font-size: 8rem; }
    .mm-404__title { font-size: 2.2rem; }
  }
</style>

<section
  class="mm-404"
  style="
    --mm404-bg: {{ section.settings.background_color | default: '#F0EDDF' }};
    --mm404-text: {{ section.settings.text_color | default: '#1E4366' }};
  "
>
  {%- if section.settings.watermark_image != blank -%}
    <div class="mm-404__watermark" aria-hidden="true">
      <img src="{{ section.settings.watermark_image | image_url: width: 600 }}" alt="" width="600" height="150" loading="lazy" decoding="async">
    </div>
  {%- endif -%}

  <p class="mm-404__code" aria-hidden="true">404</p>
  <h1 class="mm-404__title">{{ section.settings.title | default: 'Nothing here but carob pods.' }}</h1>
  <p class="mm-404__message">{{ section.settings.message | default: 'The page you were looking for has moved or never existed. But the carob is still here.' }}</p>
  <a class="mm-404__cta" href="{{ section.settings.cta_url | default: '/shop' }}">{{ section.settings.cta_text | default: 'Shop the Range' }}</a>
  <a class="mm-404__back" href="{{ routes.root_url }}">Back to homepage</a>
</section>

{% schema %}
{
  "name": "404 Page",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Nothing here but carob pods."
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Message",
      "default": "The page you were looking for has moved or never existed. But the carob is still here."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Shop the Range"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    },
    {
      "type": "image_picker",
      "id": "watermark_image",
      "label": "Background watermark"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F0EDDF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1E4366"
    }
  ]
}
{% endschema %}
