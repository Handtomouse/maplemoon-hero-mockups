{%- comment -%} MapleMoon Article (Blog Post) Section {%- endcomment -%}

<style>
  .mm-article { max-width: 720px; margin: 0 auto; padding: 80px 24px 64px; color: #1E4366; font-family: 'Neue Haas Grotesk Display Pro', 'Inter', sans-serif; }
  .mm-article__meta { font-size: 0.7rem; font-weight: 400; opacity: 0.4; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 12px; }
  .mm-article__title { font-family: 'P22 Mackinac Pro', Georgia, serif; font-size: 2rem; font-weight: 400; margin: 0 0 16px; line-height: 1.2; }
  .mm-article__image { width: 100%; border-radius: 16px; overflow: hidden; margin-bottom: 32px; }
  .mm-article__image img { width: 100%; height: auto; display: block; }
  .mm-article__content { font-size: 1rem; font-weight: 300; line-height: 1.8; }
  .mm-article__content p { margin: 0 0 16px; }
  .mm-article__content h2 { font-family: 'P22 Mackinac Pro', Georgia, serif; font-size: 1.5rem; font-weight: 400; margin: 32px 0 12px; }
  .mm-article__content h3 { font-family: 'P22 Mackinac Pro', Georgia, serif; font-size: 1.2rem; font-weight: 500; margin: 24px 0 8px; }
  .mm-article__content ul, .mm-article__content ol { padding-left: 24px; margin: 0 0 16px; }
  .mm-article__content li { margin-bottom: 4px; }
  .mm-article__content a { color: #1E4366; text-decoration: underline; text-underline-offset: 3px; }
  .mm-article__content img { max-width: 100%; height: auto; border-radius: 12px; margin: 16px 0; }
  .mm-article__content blockquote { border-left: 3px solid #E1D78E; padding-left: 20px; margin: 24px 0; font-style: italic; opacity: 0.8; }
  .mm-article__nav { display: flex; justify-content: space-between; gap: 16px; margin-top: 48px; padding-top: 24px; border-top: 1px solid rgba(30,67,102,0.08); }
  .mm-article__nav a { font-size: 0.8rem; font-weight: 400; color: #1E4366; text-decoration: none; opacity: 0.5; transition: opacity 0.2s; }
  .mm-article__nav a:hover { opacity: 1; }
  .mm-article__back { display: inline-block; margin-top: 24px; font-size: 0.8rem; font-weight: 300; color: #1E4366; opacity: 0.4; text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 768px) { .mm-article { padding: 96px 48px 80px; } .mm-article__title { font-size: 2.8rem; } }
</style>

<article class="mm-article">
  <p class="mm-article__meta">
    {{ article.published_at | date: '%B %d, %Y' }}
    {%- if article.author != blank %} &middot; {{ article.author }}{% endif -%}
  </p>
  <h1 class="mm-article__title">{{ article.title }}</h1>

  {%- if article.image -%}
    <div class="mm-article__image">
      <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.image.alt | default: article.title | escape }}" width="1200" height="675" loading="eager" decoding="async">
    </div>
  {%- endif -%}

  <div class="mm-article__content">
    {{ article.content }}
  </div>

  <nav class="mm-article__nav" aria-label="Article navigation">
    {%- if blog.previous_article -%}
      <a href="{{ blog.previous_article }}">&larr; Previous</a>
    {%- else -%}
      <span></span>
    {%- endif -%}
    {%- if blog.next_article -%}
      <a href="{{ blog.next_article }}">Next &rarr;</a>
    {%- endif -%}
  </nav>

  <a href="{{ blog.url }}" class="mm-article__back">&larr; Back to {{ blog.title | default: 'Journal' }}</a>
</article>

{% schema %}
{
  "name": "Article",
  "tag": "div"
}
{% endschema %}
