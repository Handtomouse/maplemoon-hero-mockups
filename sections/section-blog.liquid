{%- comment -%} MapleMoon Blog Listing Section {%- endcomment -%}

<style>
  .mm-blog { max-width: 1200px; margin: 0 auto; padding: 80px 24px 64px; color: var(--bl-text, #1E4366); font-family: 'Neue Haas Grotesk Display Pro', 'Inter', sans-serif; }
  .mm-blog__title { font-family: 'P22 Mackinac Pro', Georgia, serif; font-size: 2rem; font-weight: 400; text-align: center; margin: 0 0 40px; }
  .mm-blog__grid { display: grid; grid-template-columns: 1fr; gap: 32px; }
  .mm-blog__card { text-decoration: none; color: inherit; display: flex; flex-direction: column; }
  .mm-blog__card-img { aspect-ratio: 16/9; border-radius: 12px; overflow: hidden; background: var(--bl-warm, #EDE8D4); margin-bottom: 16px; }
  .mm-blog__card-img img { width: 100%; height: 100%; object-fit: cover; }
  .mm-blog__card-date { font-size: 0.7rem; font-weight: 400; opacity: 0.4; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px; }
  .mm-blog__card-title { font-family: 'P22 Mackinac Pro', Georgia, serif; font-size: 1.2rem; font-weight: 500; margin-bottom: 8px; line-height: 1.3; }
  .mm-blog__card-excerpt { font-size: 0.85rem; font-weight: 300; opacity: 0.7; line-height: 1.6; }
  .mm-blog__card-read { font-size: 0.75rem; font-weight: 400; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.5; margin-top: 12px; transition: opacity 0.2s; }
  .mm-blog__card:hover .mm-blog__card-read { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) { .mm-blog__card { transition: transform 0.3s ease; } .mm-blog__card:hover { transform: translateY(-4px); } }
  @media (prefers-reduced-motion: reduce) { .mm-blog__card { transition: none !important; } }
  @media (min-width: 768px) { .mm-blog { padding: 96px 48px 80px; } .mm-blog__title { font-size: 2.5rem; } .mm-blog__grid { grid-template-columns: repeat(2, 1fr); gap: 40px; } }
  @media (min-width: 1024px) { .mm-blog__grid { grid-template-columns: repeat(3, 1fr); } }
</style>

<section class="mm-blog" style="--bl-text: {{ section.settings.text_color | default: '#1E4366' }}; --bl-warm: {{ section.settings.card_bg | default: '#EDE8D4' }};">
  <h1 class="mm-blog__title">{{ blog.title | default: section.settings.title | default: 'Journal' }}</h1>

  {%- if blog.articles.size > 0 -%}
    <div class="mm-blog__grid">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="mm-blog__card">
          {%- if article.image -%}
            <div class="mm-blog__card-img">
              <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.image.alt | default: article.title | escape }}" width="600" height="338" loading="lazy" decoding="async">
            </div>
          {%- endif -%}
          <span class="mm-blog__card-date">{{ article.published_at | date: '%B %d, %Y' }}</span>
          <span class="mm-blog__card-title">{{ article.title }}</span>
          <span class="mm-blog__card-excerpt">{{ article.excerpt_or_content | strip_html | truncate: 160 }}</span>
          <span class="mm-blog__card-read">Read more</span>
        </a>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav aria-label="Blog pagination" style="text-align:center; margin-top:40px;">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  {%- else -%}
    <p style="text-align:center; opacity:0.6; font-weight:300;">No articles yet. Check back soon.</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Blog",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "title", "label": "Fallback title", "default": "Journal" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1E4366" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#EDE8D4" }
  ]
}
{% endschema %}
