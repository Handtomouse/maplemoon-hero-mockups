{%- comment -%}
  MapleMoon Product Main Section
  Based on product_v7a.html (Light Educational).
  Split layout: image gallery left, product info + buy box right.
  Tabs: Details, Ingredients, Reviews.
  Presentational — wire to Shopify product objects when implementing theme.
{%- endcomment -%}

<style>
  /* =============================================
     PRODUCT MAIN — Base (mobile-first)
     ============================================= */
  .prod-main {
    position: relative;
    width: 100%;
    padding: 24px 20px max(32px, env(safe-area-inset-bottom));
    background: var(--pm-bg);
    color: var(--pm-text);
    font-family: var(--pm-sans, 'Neue Haas Grotesk Display Pro', 'Inter', 'Helvetica Neue', sans-serif);
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }
  .prod-main__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .prod-main, .prod-main * {
      transition: none !important;
      animation: none !important;
    }
  }

  /* ── Product hero: image + info ── */
  .prod-main__hero {
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin-bottom: 40px;
  }

  /* ── Image area ── */
  .prod-main__image-area {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
    overflow: hidden;
    background: var(--pm-warm, #EDE8D4);
    border-radius: 24px;
  }
  .prod-main__image-area .prod-main__watermark {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }
  .prod-main__image-area .prod-main__watermark img {
    width: 80%;
    opacity: 0.08;
    filter: sepia(1) saturate(2) hue-rotate(-10deg) brightness(0.85);
  }
  .prod-main__main-img {
    position: relative;
    z-index: 2;
    max-height: 300px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 4px 8px rgba(0,0,0,0.06))
            drop-shadow(0 12px 24px rgba(0,0,0,0.08));
    transition: opacity 0.3s ease;
  }

  /* ── Thumbnails ── */
  .prod-main__thumbs {
    position: relative;
    z-index: 2;
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-top: 16px;
  }
  .prod-main__thumb {
    width: 52px;
    height: 52px;
    border-radius: 4px;
    border: 1.5px solid rgba(0,0,0,0.1);
    overflow: hidden;
    cursor: pointer;
    padding: 4px;
    background: rgba(255,255,255,0.6);
    transition: border-color 0.2s;
  }
  .prod-main__thumb:hover,
  .prod-main__thumb.active { border-color: var(--pm-text); }
  .prod-main__thumb img { width: 100%; height: 100%; object-fit: contain; }
  .prod-main__thumb:focus-visible { outline: 2px solid var(--pm-text); outline-offset: 2px; }

  /* ── Product info ── */
  .prod-main__info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Breadcrumb */
  .prod-main__breadcrumb {
    font-size: 0.75rem;
    font-weight: 400;
    opacity: 0.45;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .prod-main__breadcrumb a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .prod-main__breadcrumb a:hover { opacity: 1; }

  /* Name */
  .prod-main__name {
    font-family: var(--pm-serif, 'P22 Mackinac Pro', Georgia, serif);
    font-size: 1.8rem;
    font-weight: 400;
    margin: 0;
    line-height: 1.2;
  }

  /* Tagline */
  .prod-main__tagline {
    font-size: 0.9rem;
    font-weight: 300;
    opacity: 0.7;
    line-height: 1.6;
    margin: 0;
  }

  /* Price + weight */
  .prod-main__meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: 4px;
  }
  .prod-main__price {
    font-family: var(--pm-serif, 'P22 Mackinac Pro', Georgia, serif);
    font-size: 1.3rem;
    font-weight: 400;
  }
  .prod-main__weight {
    font-size: 0.82rem;
    font-weight: 300;
    opacity: 0.5;
  }

  /* Trust badges inline */
  .prod-main__badges {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 8px;
  }
  .prod-main__badge {
    position: relative;
    display: inline-flex;
    cursor: default;
  }
  .prod-main__badge:hover::after,
  .prod-main__badge:focus::after {
    content: attr(data-tooltip);
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: var(--pm-text);
    color: var(--pm-bg, #F0EDDF);
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 0.7rem;
    white-space: nowrap;
    pointer-events: none;
    margin-bottom: 4px;
  }
  .prod-main__badge img {
    width: 22px;
    height: 22px;
    opacity: 0.65;
    filter: brightness(0.4);
  }

  /* ── Quantity + Add to Cart ── */
  .prod-main__buy-row {
    display: flex;
    align-items: center;
    gap: 16px;
    align-self: flex-start;
  }
  .prod-main__qty {
    display: flex;
    align-items: center;
    border: 1.5px solid rgba(0,0,0,0.15);
    border-radius: 50px;
    overflow: hidden;
  }
  .prod-main__qty-btn {
    width: 40px;
    height: 40px;
    background: transparent;
    border: none;
    font-size: 1rem;
    color: var(--pm-text);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }
  .prod-main__qty-btn:hover { background: rgba(0,0,0,0.05); }
  .prod-main__qty-btn:focus-visible { outline: 2px solid var(--pm-text); outline-offset: -2px; }
  .prod-main__qty-input {
    width: 40px;
    text-align: center;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--pm-text);
    border: none;
    background: none;
    -moz-appearance: textfield;
  }
  .prod-main__qty-input::-webkit-outer-spin-button,
  .prod-main__qty-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  .prod-main__add-to-cart {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--pm-accent, #E1D78E);
    color: var(--pm-text);
    background: var(--pm-accent, #E1D78E);
    border-radius: 50px;
    padding: 14px 40px;
    min-height: 48px;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.3s, color 0.3s, border-color 0.3s;
  }
  .prod-main__add-to-cart:hover {
    background: var(--pm-text);
    color: var(--pm-bg, #F0EDDF);
    border-color: var(--pm-text);
  }
  .prod-main__add-to-cart:focus-visible {
    outline: 2px solid var(--pm-text);
    outline-offset: 4px;
  }
  .prod-main__add-to-cart--disabled {
    opacity: 0.4;
    pointer-events: none;
    cursor: not-allowed;
    background: transparent;
    border-color: var(--pm-text);
  }

  /* ── Shipping trust line ── */
  .prod-main__shipping {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 8px;
  }
  .prod-main__shipping span {
    font-size: 0.75rem;
    font-weight: 300;
    opacity: 0.5;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .prod-main__shipping-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--pm-accent, #E1D78E);
    flex-shrink: 0;
  }

  /* ── Educational callout ── */
  .prod-main__callout {
    background: var(--pm-callout, #E8E3CF);
    border-radius: 0 12px 12px 0;
    padding: 24px 32px;
    margin-bottom: 32px;
    border-left: 3px solid var(--pm-accent, #E1D78E);
  }
  .prod-main__callout-title {
    font-family: var(--pm-serif, 'P22 Mackinac Pro', Georgia, serif);
    font-size: 0.95rem;
    font-weight: 500;
    margin: 0 0 8px;
  }
  .prod-main__callout-body {
    font-size: 0.85rem;
    font-weight: 300;
    line-height: 1.7;
    opacity: 0.85;
    margin: 0;
  }

  /* ── Tab section ── */
  .prod-main__tabs {
    margin-bottom: 32px;
  }
  .prod-main__tab-bar {
    display: flex;
    gap: 0;
    border-bottom: 1px solid rgba(0,0,0,0.08);
    margin-bottom: 24px;
  }
  .prod-main__tab-btn {
    font-family: var(--pm-serif, 'P22 Mackinac Pro', Georgia, serif);
    font-size: 0.8rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--pm-text);
    background: none;
    border: none;
    cursor: pointer;
    padding: 12px 20px;
    opacity: 0.4;
    transition: opacity 0.2s;
    min-height: 44px;
    position: relative;
  }
  .prod-main__tab-btn::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 20px;
    right: 20px;
    height: 2px;
    background: var(--pm-accent, #E1D78E);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .prod-main__tab-btn[aria-selected="true"] { opacity: 1; }
  .prod-main__tab-btn[aria-selected="true"]::after { opacity: 1; }
  .prod-main__tab-btn:hover { opacity: 0.7; }
  .prod-main__tab-btn:focus-visible {
    outline: 2px solid var(--pm-text);
    outline-offset: 4px;
  }

  .prod-main__tab-panel {
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.7;
    opacity: 0.8;
  }
  .prod-main__tab-panel[hidden] { display: none; }
  .prod-main__tab-panel p { margin: 0 0 12px; }
  .prod-main__tab-panel p:last-child { margin-bottom: 0; }
  .prod-main__tab-panel ul,
  .prod-main__tab-panel ol { padding-left: 20px; margin: 0 0 12px; }
  .prod-main__tab-panel li { margin-bottom: 4px; }
  .prod-main__tab-panel a { color: var(--pm-text); text-decoration: underline; text-underline-offset: 3px; }
  .prod-main__tab-panel a:hover { opacity: 0.6; }
  .prod-main__tab-panel strong { font-weight: 500; }

  /* =============================================
     DESKTOP (768px+)
     ============================================= */
  @media (min-width: 768px) {
    .prod-main { padding: 40px 48px 48px; }

    .prod-main__hero {
      flex-direction: row;
      gap: 48px;
      align-items: flex-start;
    }
    .prod-main__image-area {
      flex: 0 0 45%;
      position: sticky;
      top: 120px;
      padding: 48px 32px;
      max-height: calc(100vh - 160px);
      overflow: hidden;
    }
    .prod-main__main-img {
      max-height: 400px;
    }
    .prod-main__info {
      flex: 1;
      padding-top: 8px;
    }
    .prod-main__name { font-size: 2.2rem; }
    .prod-main__tab-btn { font-size: 0.85rem; padding: 16px 32px; }
  }

  @media (min-width: 1024px) {
    .prod-main__name { font-size: 2.4rem; }
    .prod-main__tab-btn { font-size: 0.88rem; }
    .prod-main__image-area { padding: 56px 40px; }
    .prod-main__main-img { max-height: 440px; }
  }
</style>

<section
  class="prod-main"
  id="prod-main-{{ section.id }}"
  aria-label="Product"
  style="
    --pm-bg: {{ section.settings.background_color | default: '#F0EDDF' }};
    --pm-text: {{ section.settings.text_color | default: '#1E4366' }};
    --pm-accent: {{ section.settings.accent_color | default: '#E1D78E' }};
    --pm-warm: {{ section.settings.image_bg_color | default: '#EDE8D4' }};
    --pm-callout: {{ section.settings.callout_bg_color | default: '#E8E3CF' }};
    --pm-serif: 'P22 Mackinac Pro', Georgia, serif;
    --pm-sans: 'Neue Haas Grotesk Display Pro', 'Inter', 'Helvetica Neue', sans-serif;
  "
>
  <div class="prod-main__inner">
    {%- comment -%} ── Product hero: image + info ── {%- endcomment -%}
    <div class="prod-main__hero">
      <div class="prod-main__image-area">
        {%- if section.settings.watermark_image != blank -%}
          <div class="prod-main__watermark" aria-hidden="true">
            <img src="{{ section.settings.watermark_image | image_url: width: 800 }}" alt="" width="800" height="200" loading="lazy" decoding="async">
          </div>
        {%- endif -%}

        {%- if section.settings.product_image != blank -%}
          <img
            src="{{ section.settings.product_image | image_url: width: 600 }}"
            class="prod-main__main-img"
            alt="{{ section.settings.product_name | escape }}"
            width="400" height="600"
            loading="eager" fetchpriority="high" decoding="async"
          >
        {%- endif -%}

        {%- assign has_thumbs = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'thumbnail' -%}{%- assign has_thumbs = true -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
        {%- if has_thumbs -%}
          <div class="prod-main__thumbs">
            {%- for block in section.blocks -%}
              {%- if block.type == 'thumbnail' and block.settings.image != blank -%}
                <button class="prod-main__thumb{% if forloop.first %} active{% endif %}" type="button"
                  data-src="{{ block.settings.image | image_url: width: 600 }}"
                  aria-label="{{ block.settings.label | default: 'View' | escape }}"
                  {{ block.shopify_attributes }}>
                  <img src="{{ block.settings.image | image_url: width: 104 }}" alt="" width="52" height="52" loading="lazy" decoding="async">
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="prod-main__info">
        {%- if section.settings.breadcrumb_text != blank -%}
          <nav class="prod-main__breadcrumb" aria-label="Breadcrumb">{{ section.settings.breadcrumb_text }}</nav>
        {%- endif -%}

        <h1 class="prod-main__name">{{ section.settings.product_name | default: 'Pure Carob Bar' }}</h1>

        {%- if section.settings.tagline != blank -%}
          <p class="prod-main__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}

        <div class="prod-main__meta">
          <span class="prod-main__price">{{ section.settings.price | default: '$XX.XX' }}</span>
          {%- if section.settings.weight != blank -%}
            <span class="prod-main__weight">{{ section.settings.weight }}</span>
          {%- endif -%}
        </div>

        {%- comment -%} ── Trust badges ── {%- endcomment -%}
        {%- assign has_badges = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_badge' -%}{%- assign has_badges = true -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
        {%- if has_badges -%}
          <div class="prod-main__badges">
            {%- for block in section.blocks -%}
              {%- if block.type == 'trust_badge' and block.settings.icon != blank -%}
                <span class="prod-main__badge" tabindex="0" role="img"
                  aria-label="{{ block.settings.label | escape }}"
                  data-tooltip="{{ block.settings.label | escape }}"
                  title="{{ block.settings.label | escape }}"
                  {{ block.shopify_attributes }}>
                  <img src="{{ block.settings.icon | image_url: width: 64 }}" alt="{{ block.settings.label | escape }}" width="22" height="22" loading="lazy" decoding="async">
                </span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%} ── Buy box ── {%- endcomment -%}
        <div class="prod-main__buy-row">
          <div class="prod-main__qty">
            <button class="prod-main__qty-btn" type="button" aria-label="Decrease quantity">&#8722;</button>
            <input class="prod-main__qty-input" type="number" value="1" min="1" max="99" aria-label="Quantity">
            <button class="prod-main__qty-btn" type="button" aria-label="Increase quantity">&#43;</button>
          </div>
          <button class="prod-main__add-to-cart{% if section.settings.is_sold_out %} prod-main__add-to-cart--disabled{% endif %}" type="button" {% if section.settings.is_sold_out %}disabled aria-disabled="true"{% endif %}>{% if section.settings.is_sold_out %}Sold Out{% else %}{{ section.settings.cta_text | default: 'Add to Cart' }}{% endif %}</button>
        </div>

        <div class="prod-main__shipping">
          <span><span class="prod-main__shipping-dot"></span>{{ section.settings.shipping_line_1 | default: 'Free shipping on orders over $99' }}</span>
          <span><span class="prod-main__shipping-dot"></span>{{ section.settings.shipping_line_2 | default: 'Handmade in Byron Bay' }}</span>
        </div>
      </div>
    </div>

    {%- comment -%} ── Educational callout ── {%- endcomment -%}
    {%- if section.settings.callout_title != blank -%}
      <div class="prod-main__callout">
        <h2 class="prod-main__callout-title">{{ section.settings.callout_title }}</h2>
        {%- if section.settings.callout_body != blank -%}
          <p class="prod-main__callout-body">{{ section.settings.callout_body }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} ── Tab section ── {%- endcomment -%}
    {%- assign has_tabs = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'tab' -%}{%- assign has_tabs = true -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
    {%- if has_tabs -%}
      <div class="prod-main__tabs">
        <div class="prod-main__tab-bar" role="tablist" aria-label="Product information">
          {%- assign tab_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              <button class="prod-main__tab-btn" role="tab"
                id="pm-tab-{{ block.id }}"
                aria-selected="{% if tab_index == 0 %}true{% else %}false{% endif %}"
                aria-controls="pm-panel-{{ block.id }}"
                tabindex="{% if tab_index == 0 %}0{% else %}-1{% endif %}"
              >{{ block.settings.title }}</button>
              {%- assign tab_index = tab_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- assign tab_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'tab' -%}
            <div class="prod-main__tab-panel" role="tabpanel"
              id="pm-panel-{{ block.id }}"
              aria-labelledby="pm-tab-{{ block.id }}"
              {% if tab_index > 0 %}hidden{% endif %}
              {{ block.shopify_attributes }}
            >{{ block.settings.content }}</div>
            {%- assign tab_index = tab_index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
(function() {
  'use strict';
  function initProductMain() {
    var root = document.querySelector('.prod-main');
    if (!root) return;

    /* ── Thumbnail gallery ── */
    var mainImg = root.querySelector('.prod-main__main-img');
    var thumbs = root.querySelectorAll('.prod-main__thumb');
    thumbs.forEach(function(t) {
      t.addEventListener('click', function() {
        thumbs.forEach(function(th) { th.classList.remove('active'); });
        this.classList.add('active');
        if (mainImg && this.dataset.src) mainImg.src = this.dataset.src;
      });
    });

    /* ── Quantity stepper ── */
    var qtyInput = root.querySelector('.prod-main__qty-input');
    var qtyBtns = root.querySelectorAll('.prod-main__qty-btn');
    if (qtyInput && qtyBtns.length === 2) {
      qtyBtns[0].addEventListener('click', function() {
        var v = parseInt(qtyInput.value, 10) || 1;
        if (v > 1) qtyInput.value = v - 1;
      });
      qtyBtns[1].addEventListener('click', function() {
        var v = parseInt(qtyInput.value, 10) || 1;
        if (v < 99) qtyInput.value = v + 1;
      });
    }

    /* ── Tab switching ── */
    var tabBtns = root.querySelectorAll('.prod-main__tab-btn');
    var tabPanels = root.querySelectorAll('.prod-main__tab-panel');
    tabBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        tabBtns.forEach(function(b) {
          b.setAttribute('aria-selected', 'false');
          b.setAttribute('tabindex', '-1');
        });
        tabPanels.forEach(function(p) { p.hidden = true; });
        this.setAttribute('aria-selected', 'true');
        this.setAttribute('tabindex', '0');
        var panel = root.querySelector('#' + this.getAttribute('aria-controls'));
        if (panel) panel.hidden = false;
      });
    });

    /* ── Tab keyboard nav ── */
    var tabBar = root.querySelector('.prod-main__tab-bar');
    if (tabBar) {
      tabBar.addEventListener('keydown', function(e) {
        var btns = Array.from(tabBtns);
        var idx = btns.indexOf(document.activeElement);
        if (idx === -1) return;
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          var next = (idx + 1) % btns.length;
          btns[next].focus();
          btns[next].click();
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          var prev = (idx - 1 + btns.length) % btns.length;
          btns[prev].focus();
          btns[prev].click();
        }
      });
    }
  }
  initProductMain();
  document.addEventListener('shopify:section:load', function(e) {
    if (e.target.querySelector('.prod-main')) initProductMain();
  });
})();
</script>

{% schema %}
{
  "name": "Product Main",
  "tag": "div",
  "class": "prod-main-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "text",
      "id": "product_name",
      "label": "Product name",
      "default": "Pure Carob Bar"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Australian carob and cacao butter, hand-tempered and set. Nothing else."
    },
    {
      "type": "text",
      "id": "price",
      "label": "Price",
      "default": "$12.95",
      "info": "Replace with {{ product.price | money }} when wiring to Shopify"
