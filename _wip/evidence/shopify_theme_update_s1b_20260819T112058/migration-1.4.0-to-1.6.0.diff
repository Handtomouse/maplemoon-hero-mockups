+/***
+    * [C] Content reveal
+***/
+coretex-reveal {
+	display: block;
+
+    /* [data-reveal-trigger].is-active { } */
+
+    [data-reveal-panel] {
+        opacity: 0;
+        position: absolute; inset: 0;
+        visibility: hidden;
+        pointer-events: none;
+
+        &.is-active {
+            opacity: 1;
+            position: relative;
+            visibility: visible;
+            pointer-events: auto;
+        }
+    }
+
+    .meta { --gap: var(--space-1) }
+}
+
+/* [S] Content reveal */
+section.content-reveal {
+    --hMargin: 0px;
+    --pMargin: 0px;
+    --sticky: var(--headSpace);
+
+    padding-inline: var(--layoutInline);
+
+    :is(img,video,svg) { 
+        height: 100%;
+        max-height: 60vh;
+        width: 100%;
+        max-width: 600px;
+        object-fit: cover;
+        object-position: top;
+    }
+
+    .triggers {
+        @media (width <= 777px) { --gap-s: var(--space-4) var(--space-2) !important }
+
+        .trigger {
+            --hColor: var(--colorFaded);
+            --linkColor: var(--colorFaded);
+            --buttonColor: var(--colorFaded);
+            color: var(--colorFaded);
+            z-index: 2;
+
+            .description { 
+                position: relative;
+                opacity: 0; 
+                & > p { position: absolute; pointer-events: none; max-width: 100ch }
+            }
+
+            &.is-active {
+                --hColor: var(--color);
+                --linkColor: var(--color);
+                --buttonColor: var(--color);
+                color: var(--color);
 
+                .title, .cta a { text-decoration: underline }
+                .description { opacity: 1 }
+            }
+
+        }
+
     }
+}
+
+
+/***
+    * [C] Tabs
+***/
+tab-container.tabs {
+    display: block;
+
+    tab-controls {
+        gap: var(--tabControlsGap, var(--padding));
+        margin-block: var(--tabControlsMargin, var(--margin));
+        padding-inline: var(--tabControlsPaddingInline, 0px);
+        
+        &:has(> label:only-of-type) { display: none }
+
+        label {
+            all: unset;
+            cursor: pointer;
+
+            &:has(input:checked) { font-weight: var(--tabActiveWeight, 800); text-decoration: underline }
+            &:has(input:focus-visible) { outline: var(--a11yOutline); outline-offset: var(--a11yOffset) }
+        }
+    }
+
+    tab-content { display: none }
+
+    &:has(tab-controls label:nth-of-type(1) input:checked) > tab-content:nth-of-type(1),
+    &:has(tab-controls label:nth-of-type(2) input:checked) > tab-content:nth-of-type(2),
+    &:has(tab-controls label:nth-of-type(3) input:checked) > tab-content:nth-of-type(3),
+    &:has(tab-controls label:nth-of-type(4) input:checked) > tab-content:nth-of-type(4),
+    &:has(tab-controls label:nth-of-type(5) input:checked) > tab-content:nth-of-type(5),
+    &:has(tab-controls label:nth-of-type(6) input:checked) > tab-content:nth-of-type(6) {
+        display: block;
+        animation: tabContentIn var(--tabAnimationDuration, 300ms) var(--tabAnimationEasing, var(--globalAnimeEase)) both;
+    }
+}
+
+@keyframes tabContentIn {
+    from { opacity: 0; transform: translateY(20px); filter: blur(5px) }
+    to { opacity: 1; transform: none; filter: blur(0) }
+}
+
+/* [S] Tabbed collections */
+section.tabbed-collections {
+    --hMargin: 0px;
+    --tabActionsReserve: 12rem;
+    --tabActiveWeight: 600;
+    --sticky: var(--space-2);
+
+    header { padding-inline: var(--tabControlsPaddingInline, 0px); }
+
+    /* Of footer stealth icon is present */
+    body[coretex-footer="stealth"] & .collectionsItem > * { --sticky: var(--space-6); }
+
+    coretex-scroll, 
+    .collectionsItem > * {
+        display: flex; 
+        flex-direction: column;
+    
+        .section-heading { 
+            position: sticky;
+            inset-block-end: var(--sticky);
+            z-index: 1;
+
+            width: fit-content; 
+            order: 2;
+            margin-inline: auto;
+
+            a.button {
+                --buttonBg: var(--bgColor);
+                --buttonColor: var(--color);
+            }
+        }
+    }
+
+    @media (width >= 778px) {
+        &[stealth="true"] { 
+            :where(header,tab-controls) { opacity: 0; transition: opacity 300ms ease-in-out }
+            &:hover { :where(header,tab-controls) { opacity: 1 } }
+        }
+    }
 }
