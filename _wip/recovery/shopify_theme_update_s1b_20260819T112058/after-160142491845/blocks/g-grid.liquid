{% doc %}
    Renders a CSS Grid with configurable columns, gap and alignment.

    @example
    {% content_for 'block', type: 'g-grid' %}
{% enddoc %}

{%- liquid
    # Debug check
    assign debuger = false
    if request.design_mode and block.settings.debug
        assign debuger = true
    endif

    # skelet .debug
    capture debug
        if debuger
            echo 'debug outline' | prepend: ' '
        endif
    endcapture

    # x-grid columns
    assign columns = block.settings.columns
    assign columns_s = block.settings.columns_s
-%}

{%- capture style -%}
--gap:{{ block.settings.rowGap | prepend: 'var(--space-' | append: ')' }} {{ block.settings.columnGap | prepend: 'var(--space-' | append: ')' }}; 
{% if block.settings.mobile_gap %}--gap-s:{{ block.settings.rowGap_s | prepend: 'var(--space-' | append: ')' }} {{ block.settings.columnGap_s | prepend: 'var(--space-' | append: ')' }};{% endif %}
margin-block:{{ block.settings.marginTop | prepend: 'var(--space-' | append: ')' }} {{ block.settings.marginBottom | prepend: 'var(--space-' | append: ')' }};
{%- endcapture -%}

<x-grid 
    columns="{{ columns }}" columns-s="{{ columns_s }}" 
    ai="{{ block.settings.align_items }}" ai-s="{{ block.settings.align_items_s }}"
    ji="{{ block.settings.justify_items }}" ji-s="{{ block.settings.justify_items_s }}"
    style="{{- style | strip_newlines | strip -}}"
    class="sb-grid {{ debug }}"
    {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</x-grid>

{% schema %}
{
	"name": "Grid",
	"blocks": [{ "type": "@theme" }],
	"tag": null,
	"settings": [
        {
            "type": "checkbox",
            "id": "debug",
            "label": "Show grid outline",
            "default": false,
            "info": "Visually outline grid areas and elements. These visual aids will only appear in the theme editor and won't be visible to end users."
        },
		{
			"type": "header",
			"content": "Desktop"
		},
		{
			"type": "range",
			"label": "Columns",
			"id": "columns",
			"min": 1,
			"max": 12,
			"step": 1,
			"default": 4,
			"info": "Number of columns displayed on desktop"
		},
		{
			"type": "range",
			"label": "Horizontal gap",
			"id": "columnGap",
			"min": 0,
			"max": 30,
			"step": 1,
			"default": 1,
			"info": "Spacing between columns on desktop"
		},
		{
			"type": "range",
			"label": "Vertical gap",
			"id": "rowGap",
			"min": 0,
			"max": 30,
			"step": 1,
			"default": 1,
			"info": "Spacing between rows on desktop"
		},
        {
            "type": "select",
            "id": "align_items",
            "label": "Vertical alignment",
            "default": "start",
            "info": "Applies when cell heights vary. Controls how cells align vertically.",
            "options": [
                { "value": "start", "label": "Start" },
                { "value": "center", "label": "Center" },
                { "value": "end", "label": "End" },
                { "value": "stretch", "label": "Stretch" }
            ]
        },
        {
            "type": "select",
            "id": "justify_items",
            "label": "Horizontal alignment",
            "default": "start",
            "options": [
                { "value": "start", "label": "Start" },
                { "value": "center", "label": "Center" },
                { "value": "end", "label": "End" },
                { "value": "stretch", "label": "Stretch" },
                { "value": "around", "label": "Space around" },
                { "value": "between", "label": "Space between" },
                { "value": "evenly", "label": "Space evenly" }
            ]
        },
		{
			"type": "header",
			"content": "Mobile"
		},
		{
			"type": "range",
			"label": "Columns",
			"id": "columns_s",
			"min": 1,
			"max": 6,
			"step": 1,
			"default": 2,
			"info": "Number of columns displayed on mobile"
		},
		{
			"type": "checkbox",
			"id": "mobile_gap",
			"label": "Custom gap",
			"info": "Use different spacing for mobile layout. If disabled, desktop gap settings will apply.",
			"default": false
		},
		{
			"type": "range",
			"label": "Vertical gap",
			"id": "rowGap_s",
			"min": 0,
			"max": 30,
			"step": 1,
			"default": 1,
			"visible_if": "{{ block.settings.mobile_gap }}",
			"info": "Spacing between rows on mobile"
		},
		{
			"type": "range",
			"label": "Horizontal gap",
			"id": "columnGap_s",
			"min": 0,
			"max": 30,
			"step": 1,
			"default": 1,
			"visible_if": "{{ block.settings.mobile_gap }}",
			"info": "Spacing between columns on mobile"
		},
        {
            "type": "select",
            "id": "align_items_s",
            "label": "Vertical alignment",
            "default": "start",
            "info": "Applies when cell heights vary. Controls how cells align vertically.",
            "options": [
                { "value": "start", "label": "Start" },
                { "value": "center", "label": "Center" },
                { "value": "end", "label": "End" },
                { "value": "stretch", "label": "Stretch" }
            ]
        },
        {
            "type": "select",
            "id": "justify_items_s",
            "label": "Horizontal alignment",
            "default": "start",
            "options": [
                { "value": "start", "label": "Start" },
                { "value": "center", "label": "Center" },
                { "value": "end", "label": "End" },
                { "value": "stretch", "label": "Stretch" },
                { "value": "around", "label": "Space around" },
                { "value": "between", "label": "Space between" },
                { "value": "evenly", "label": "Space evenly" }
            ]
        },
		{
			"type": "header",
			"content": "Margin"
		},
		{
			"type": "range",
			"id": "marginTop",
			"label": "Top",
			"min": 0,
			"max": 30,
			"step": 1,
			"default": 0
		},
		{
			"type": "range",
			"id": "marginBottom",
			"label": "Bottom",
			"min": 0,
			"max": 30,
			"step": 1,
			"default": 0
		}
	],
	"presets": [
		{
			"name": "Grid",
			"category": "Layout",
            "blocks": [
                { "type": "g-cell" },
                { "type": "g-cell" },
                { "type": "g-cell" },
                { "type": "g-cell" }
            ],
            "settings": { }
		}
	]
}
{% endschema %}
