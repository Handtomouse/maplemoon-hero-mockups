{% doc %}
	Renders a liquid block.

	@example
	{% content_for 'block', type: 'a-liquid' %}
{% enddoc %}

{%- capture block_style -%}
padding-block: {{ block.settings.paddingTop | prepend: 'var(--space-' | append: ')' }} {{ block.settings.paddingBottom | prepend: 'var(--space-' | append: ')' }};
margin-block: {{ block.settings.marginTop | prepend: 'var(--space-' | append: ')' }} {{ block.settings.marginBottom | prepend: 'var(--space-' | append: ')' }};
{%- if block.settings.paddingInline %}padding-inline:var(--layoutInline);{% endif -%}
{%- endcapture -%}

<div class="sb-custom-liquid contents atomic" style="{{- block_style | strip_newlines | strip -}}"
	{% unless section.settings.global_color_scheme %}color-scheme="{{ block.settings.color_scheme }}"{% endunless %}
	{{ block.shopify_attributes }}
>
	{{ block.settings.custom_liquid }}
</div>

{% schema %}
	{
		"name": "Custom Liquid",
		"tag": null,
		"settings": [
			{
				"type": "liquid",
				"id": "custom_liquid",
				"label": "Liquid code",
				"info": "Add app snippets or other code to create advanced customizations. [Learn more](https://shopify.dev/docs/api/liquid)"
			},
			{
				"type": "header",
				"content": "Spacing"
			},
			{
				"type": "checkbox",
				"id": "paddingInline",
				"label": "Enable lateral padding",
				"default": true
			},
			{
				"type": "range",
				"id": "marginTop",
				"label": "Margin top",
				"min": 0,
				"max": 30,
				"step": 1,
				"default": 2
			},
			{
				"type": "range",
				"id": "marginBottom",
				"label": "Margin bottom",
				"min": 0,
				"max": 30,
				"step": 1,
				"default": 2
			},
			{
				"type": "range",
				"id": "paddingTop",
				"label": "Padding top",
				"min": 0,
				"max": 30,
				"step": 1,
				"default": 2
			},
			{
				"type": "range",
				"id": "paddingBottom",
				"label": "Padding bottom",
				"min": 0,
				"max": 30,
				"step": 1,
				"default": 2
			},
			{
				"type": "header",
				"content": "Appearance"
			},
			{
				"type": "checkbox",
				"id": "global_color_scheme",
				"label": "Use global color scheme",
				"default": true
			},
			{
				"type": "color_scheme",
				"id": "color_scheme",
				"label": "Color scheme",
				"default": "coretex-1",
				"visible_if": "{{ block.settings.global_color_scheme == false }}"
			}
		],
		"presets": [
			{
				"name": "Custom Liquid",
				"category": "Basic",
				"settings": {}
			}
		]
	}
{% endschema %}
