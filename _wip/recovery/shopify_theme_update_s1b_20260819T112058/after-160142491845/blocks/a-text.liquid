{% doc %}
    Renders a text or heading block.

    @example
    {% content_for 'block', type: 'a-text' %}
{% enddoc %}

{%- liquid
    assign tag = block.settings.tag
    assign custom_typo = block.settings.enable_custom_typography
-%}

{%- capture block_style -%}
{%- if custom_typo -%}
{{- block.settings.font_size | prepend: '--_fontSize:var(--type-' | append: ');' -}}
{{- block.settings.font_size_s | prepend: '--_fontSizeMob:var(--type-' | append: ');' -}}
{{- block.settings.font_family | prepend: '--_fontFamily:var(--' | append: ');' -}}
{{- block.settings.font_weight | prepend: '--_fontWeight:' | append: ';' -}}
{{- block.settings.line_height | prepend: '--_hLine:' | append: 'em;' -}}
{{- block.settings.letter_spacing | divided_by: 100.0 | prepend: '--_hSpace:' | append: 'em;' -}}
{%- endif -%}
{{- block.settings.text_indent | prepend: '--_textIndent:var(--space-' | append: ');' -}}
{{- block.settings.text_transform | prepend: '--_textTransform:' | append: ';' -}}
{{- block.settings.text_align | replace: 'left', 'start' | replace: 'right', 'end' | prepend: '--_textAlign:' | append: ';' }}
{%- if block.settings.color %}{{ block.settings.color_custom | prepend: '--_color:' | append: ';' }}{% endif -%}
--_padding:{{- block.settings.paddingTop | prepend: 'var(--space-' | append: ')' }} {{- block.settings.paddingRight | prepend: 'var(--space-' | append: ')' }} {{ block.settings.paddingBottom | prepend: 'var(--space-' | append: ')' }} {{- block.settings.paddingLeft | prepend: 'var(--space-' | append: ')' }};
{%- endcapture -%}

<div class="sb-text contents atomic" {{ block.shopify_attributes }}>
    <{{ tag }} class="content" style="{{ block_style | strip_newlines | strip }}">
        {{ block.settings.text | replace: '\n', '<br/>' }}
    </{{ tag }}>
</div>

{%- stylesheet -%}
/*** [SB] Text block */
.sb-text .content {
    text-align: var(--_textAlign);
    text-indent: var(--_textIndent);
    text-transform: var(--_textTransform);
    padding: var(--_padding);
    color: var(--_color, inherit);

    font-family: var(--_fontFamily, inherit);
    font-size: var(--_fontSize, inherit);
    font-weight: var(--_fontWeight, inherit);
    letter-spacing: var(--_hSpace, inherit);

    @media (width >= 777px) { line-height: var(--_hLine, inherit); }
    @media (width <= 777px) { font-size: var(--_fontSizeMob, var(--_fontSize, inherit)); line-height: 2ex }
}
{%- endstylesheet -%}

{% schema %}
{
	"name": "Text",
	"tag": null,
	"settings": [
		{
			"type": "text",
			"id": "text",
			"label": "Text",
			"default": "Add your message here. Use HTML for formatting, then adjust font, size, spacing, and alignment to match your brand."
		},
		{
			"type": "select",
			"id": "tag",
			"label": "Element",
			"default": "p",
			"options": [
				{ "value": "p", "label": "Paragraph (p)" },
				{ "value": "div", "label": "Block (div)" },
				{ "value": "span", "label": "Inline (span)" },
				{ "value": "h1", "label": "Heading 1 (h1)" },
				{ "value": "h2", "label": "Heading 2 (h2)" },
				{ "value": "h3", "label": "Heading 3 (h3)" },
				{ "value": "h4", "label": "Heading 4 (h4)" },
				{ "value": "h5", "label": "Heading 5 (h5)" },
				{ "value": "h6", "label": "Heading 6 (h6)" },
				{ "value": "sup", "label": "Superscript (sup)" },
				{ "value": "sub", "label": "Subscript (sub)" },
				{ "value": "em", "label": "Italic (em)" },
				{ "value": "mark", "label": "Highlight (mark)" },
				{ "value": "blockquote", "label": "Quote (blockquote)" }
			],
			"info": "Defines the HTML element. Use h1-h6 for headings (important for SEO and accessibility). Use only one h1 per page."
		},
		{
			"type": "header",
			"content": "Typography"
		},
		{
			"type": "checkbox",
			"id": "enable_custom_typography",
			"label": "Custom typography",
			"default": false,
			"info": "Override the global heading or body styles for this block only"
		},
		{
			"type": "select",
			"id": "font_family",
			"label": "Font",
			"default": "fontFamily",
			"visible_if": "{{ block.settings.enable_custom_typography }}",
			"options": [
				{
					"value": "fontFamily",
					"label": "Body"
				},
				{
					"value": "hFontFamily",
					"label": "Headings"
				}
			]
		},
		{
			"type": "select",
			"id": "font_weight",
			"label": "Font weight",
			"default": "normal",
			"visible_if": "{{ block.settings.enable_custom_typography }}",
			"options": [
				{
					"value": "normal",
					"label": "Normal"
				},
				{
					"value": "bold",
					"label": "Bold"
				}
			]
		},
		{
			"type": "range",
			"id": "font_size",
			"label": "Size - desktop",
			"min": 1,
			"max": 30,
			"step": 1,
			"default": 8,
			"visible_if": "{{ block.settings.enable_custom_typography }}",
			"info": "Font size on desktop"
		},
		{
			"type": "range",
			"id": "font_size_s",
			"label": "Size - mobile",
			"min": 1,
			"max": 30,
			"step": 1,
			"default": 4,
			"visible_if": "{{ block.settings.enable_custom_typography }}",
			"info": "Font size on mobile"
		},
		{
			"type": "range",
			"label": "Line height",
			"id": "line_height",
			"min": 0.8,
			"max": 2.5,
			"step": 0.1,
			"default": 1,
			"visible_if": "{{ block.settings.enable_custom_typography }}",
			"info": "Automatically optimized for mobile"
		},
		{
			"type": "range",
			"label": "Letter spacing",
			"id": "letter_spacing",
			"min": -50,
			"max": 200,
			"step": 5,
			"default": 0,
			"visible_if": "{{ block.settings.enable_custom_typography }}",
			"info": "Automatically optimized for mobile"
		},
		{
			"type": "header",
			"content": "Formatting"
		},
		{
			"type": "text_alignment",
			"id": "text_align",
			"label": "Text alignment",
			"default": "left"
		},
		{
			"type": "select",
			"id": "text_transform",
			"label": "Text transform",
			"default": "none",
			"options": [
				{
					"value": "none",
					"label": "None"
				},
				{
					"value": "uppercase",
					"label": "Uppercase"
				},
				{
					"value": "lowercase",
					"label": "Lowercase"
				},
				{
					"value": "capitalize",
					"label": "Capitalize"
				}
			]
		},
		{
			"type": "range",
			"id": "text_indent",
			"label": "Indent",
			"min": 0,
			"max": 30,
			"step": 1,
			"default": 0,
			"info": "Distance from the left edge to the start of the text"
		},
		{
			"type": "header",
			"content": "Padding"
		},
		{
			"type": "range",
			"id": "paddingTop",
			"label": "Top",
			"min": 0,
			"max": 30,
			"step": 1,
			"default": 0
		},
		{
			"type": "range",
			"id": "paddingRight",
			"label": "Right",
			"min": 0,
			"max": 30,
			"step": 1,
			"default": 0
		},
		{
			"type": "range",
			"id": "paddingBottom",
			"label": "Bottom",
			"min": 0,
			"max": 30,
			"step": 1,
			"default": 0
		},
		{
			"type": "range",
			"id": "paddingLeft",
			"label": "Left",
			"min": 0,
			"max": 30,
			"step": 1,
			"default": 0
		},
		{
			"type": "header",
			"content": "Appearance"
		},
		{
			"type": "checkbox",
			"id": "color",
			"label": "Enable custom color",
			"default": false,
			"info": "Enable to use a custom text color"
		},
		{
			"type": "color",
			"id": "color_custom",
			"label": "Text color",
			"default": "#000000",
			"visible_if": "{{ block.settings.color }}"
		}
	],
	"presets": [
		{
			"name": "Text",
			"category": "Basic",
			"settings": { "tag": "p" }
		},
		{
			"name": "Heading",
			"category": "Basic",
			"settings": { "tag": "h2", "text": "Heading" }
		}
	]
}
{% endschema %}
