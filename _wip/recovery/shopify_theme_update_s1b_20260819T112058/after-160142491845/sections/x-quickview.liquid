{%- comment -%}
	Quick View section fragment for Shopify Section Rendering API
	Used via /products/{handle}?section_id=x-quickview
{%- endcomment -%}

{%- liquid
	# Product form ID for quick view
	assign product_form_id = 'qv-product-form-' | append: section.id

	# Get selected or first available variant - may be null for invalid combinations
	assign current_variant = product.selected_or_first_available_variant

	# Check availability - handle null variant case
	assign variant_available = false
	if current_variant
		assign variant_available = current_variant.available
	endif

	# Check if we have a valid variant combination
	assign has_valid_variant = false
	if current_variant
		assign has_valid_variant = true
	endif

	# Check if product has preorder tag
    # Preorder tag (normalize + handle spelling variants)
    assign pre_order = false
    assign tags_csv = product.tags | join: ',' | downcase
    if tags_csv contains 'preorder' or tags_csv contains 'pre-order' or tags_csv contains 'pre order'
        assign pre_order = true
    endif
-%}

{% stylesheet %}
	/* Quick View Container */
	.qvContainer {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		padding: var(--space-4);
		max-width: 500px;
		width: 100%;
	}

	/* Media Section */
	.qvMedia {
		aspect-ratio: 1;
		width: 100%;
		max-width: 300px;
		margin: 0 auto;
	}

	.qvMedia img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: var(--globalRadius);
	}

	/* Product Info Section */
	.qvInfo {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.qvTitle {
		margin: 0;
		color: var(--colorBody);
		text-decoration: none;
	}

	.qvTitle:hover {
		color: var(--colorAccent);
	}

	.qvVendor,
	.qvSku {
		color: var(--colorFaded);
		font-size: var(--fontSize-small);
	}

	/* Form Section */
	.qvForm {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.qvQuantity {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	.qvQuantity label {
		color: var(--colorBody);
		font-weight: 500;
	}

	.qvQuantity input {
		width: 80px;
		padding: var(--space-1) var(--space-2);
		border: 1px solid var(--colorBorder);
		border-radius: var(--globalRadius);
		text-align: center;
	}

	.qv__atc {
		padding: var(--space-2) var(--space-3);
		background: var(--colorAccent);
		color: var(--colorBg);
		border: none;
		border-radius: var(--globalRadius);
		font-weight: 500;
		cursor: pointer;
		transition: background-color 0.2s ease;
	}

	.qv__atc:hover:not(:disabled) {
		background: var(--colorAccentHover, var(--colorAccent));
	}

	.qv__atc:disabled {
		background: var(--colorFaded);
		cursor: not-allowed;
	}

	/* Variant Picker Section */
	.qvVariantPicker {
		margin: var(--space-2) 0;
	}

	.variant-pickers {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.variant-option {
		border: none;
		padding: 0;
		margin: 0;
	}

	.variant-option__legend {
		font-weight: 500;
		margin-bottom: var(--space-1);
		color: var(--colorBody);
	}

	.variant-option__selected {
		font-weight: normal;
		color: var(--colorFaded);
	}

	.variant-option__select {
		width: 100%;
		padding: var(--space-1) var(--space-2);
		border: 1px solid var(--colorBorder);
		border-radius: var(--globalRadius);
		background: var(--colorBg);
		color: var(--colorBody);
	}

	.variant-option__select:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}

	.variant-option__values {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
	}

	.variant-option__value {
		position: relative;
	}

	.variant-option__value--disabled {
		opacity: 0.5;
	}

	.variant-option__input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.variant-option__label {
		display: block;
		padding: var(--space-1) var(--space-2);
		border: 1px solid var(--colorBorder);
		border-radius: var(--globalRadius);
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.variant-option__input:checked + .variant-option__label {
		background: var(--colorAccent);
		color: var(--colorBg);
		border-color: var(--colorAccent);
	}

	.variant-option__input:disabled + .variant-option__label {
		cursor: not-allowed;
		opacity: 0.5;
	}

	/* Responsive Design */
	@media (max-width: 768px) {
		.qvContainer {
			padding: var(--space-3);
		}
	}
{% endstylesheet %}

<div class="qvContainer">
	{%- comment -%} Product Media {%- endcomment -%}
	{%- liquid
		# Use variant image if available, fallback to product featured image
        assign display_image = product.featured_image
        if current_variant and current_variant.featured_image
          assign display_image = current_variant.featured_image
        endif
        assign qv_image_alt = display_image.alt | default: product.title
        assign qv_image_id = 'QvImage-' | append: section.id
	-%}

	{%- if display_image -%}
		<div class="qvMedia" id="QvMedia-{{ section.id }}">
			{%-
				render 'inc-img',
				img: display_image,
				width: 600,
				widths: '300,600',
				sizes: '(max-width: 600px) 300px, 600px',
				alt: qv_image_alt,
				loading: 'lazy',
				id: qv_image_id,
				mediaLoader: true
			-%}
		</div>
	{%- endif -%}

	{%- comment -%} Product Info {%- endcomment -%}
	<div class="qvInfo">
		{%- if product.vendor -%}
			<div class="qvVendor">{{ product.vendor }}</div>
		{%- endif -%}

		<h2 class="qvTitle h5">
			<a href="{{ product.url }}" class="qvTitle">{{ product.title }}</a>
		</h2>

		{%- comment -%} Price {%- endcomment -%}
		<div class="qvPrice">
			{%- render 'c-price', product: product, use_variant: true -%}
		</div>

		{%- comment -%} SKU {%- endcomment -%}
		{%- if has_valid_variant and current_variant.sku != blank -%}
			<div class="qvSku qv__sku" id="QvSku-{{ section.id }}">
				<span class="visually-hidden">{{ 'products.product.sku' | t }}</span>
				{{ 'products.product.sku' | t }}: {{ current_variant.sku }}
			</div>
		{%- endif -%}
	</div>

	{%- comment -%} Product Form {%- endcomment -%}
	<ajax-cart-product-form cart-type="{{ settings.cart_type }}">
		{%- form 'product', product, id: product_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form', class: 'qvForm' -%}
			{%- comment -%} Hidden variant ID - handled by variant-pickers snippet or fallback {%- endcomment -%}
			{%- if product.has_only_default_variant -%}
				{%- comment -%} Single variant product - add hidden input directly {%- endcomment -%}
				<input type="hidden" name="id" value="{{ product.variants.first.id }}" class="variant-id-input">
			{%- else -%}
				{%- comment -%} Scalable Variant Picker for multi-variant products {%- endcomment -%}
				<div class="qvVariantPicker">
					{%- render 'c-prod-variant-picker', product: product, form_id: product_form_id, picker_type: 'radio', context: 'quickview' -%}
				</div>
			{%- endif -%}

			{%- comment -%} Quantity Input {%- endcomment -%}
			<div class="qvQuantity">
				<label for="QvQuantity-{{ section.id }}">{{ 'products.product.quantity.label' | t }}</label>
				<input
					type="number"
					id="QvQuantity-{{ section.id }}"
					name="quantity"
					value="1"
					min="{{ current_variant.quantity_rule.min | default: 1 }}"
					{% if has_valid_variant and current_variant.quantity_rule.max %}
						max="{{ current_variant.quantity_rule.max }}"
					{% endif %}
					step="{{ current_variant.quantity_rule.increment | default: 1 }}"
					{% unless has_valid_variant and variant_available %}
						disabled
					{% endunless %}
				>
			</div>

			{%- comment -%} Add to Cart Button {%- endcomment -%}
			<button
				type="submit"
				name="add"
				class="qv__atc"
				id="QvSubmitButton-{{ section.id }}"
				{% unless has_valid_variant and variant_available %}
					disabled
				{% endunless %}
			>
				<span>
					{%- liquid
						unless has_valid_variant
							echo 'products.product.unavailable' | t
						else
							unless variant_available
								echo 'products.product.sold_out' | t
							else
								unless pre_order
									echo 'products.product.add_to_cart' | t
								else
									echo 'openthinking.dictionary.word.preorder' | t
								endunless
							endunless
						endunless
					-%}
				</span>
			</button>
		{%- endform -%}
	</ajax-cart-product-form>

	{%- comment -%} No variants JSON needed - handled by variant-pickers snippet {%- endcomment -%}
</div>