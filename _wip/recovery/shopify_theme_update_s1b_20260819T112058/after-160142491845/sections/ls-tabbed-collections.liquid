{%- liquid
    # Load CSS
    render 'inc-stylesheet', src: 's-sections.css'

    # Layout type
    assign layoutType = section.settings.layoutType
-%}

{%- capture style -%}
{%- if layoutType == 'list' -%}--tabControlsPaddingInline:var(--layoutInline);{%- endif -%}
padding-block:{{ section.settings.paddingTop | prepend: 'var(--space-' | append: ')' }} {{ section.settings.paddingBottom | prepend: 'var(--space-' | append: ')' }};
margin-block:{{ section.settings.marginTop | prepend: 'var(--space-' | append: ')' }} {{ section.settings.marginBottom | prepend: 'var(--space-' | append: ')' }};
{%- if section.settings.useLocalCardSize -%}{{- section.settings.card_size | prepend: '--prodCardSlideRatio:' | append: 'px;' -}}{%- endif -%}
{%- endcapture -%}

<section
	class="feat-products tabbed-collections listOfProds"
	style="{{- style | strip_newlines | strip -}}"
	{% unless section.settings.global_color_scheme %}color-scheme="{{ section.settings.color_scheme }}"{% endunless %}
	data-section-id="{{ section.id }}"
    layout-type="{{ layoutType }}"
    stealth="{{ section.settings.stealthMode }}"
>
	{%- if section.settings.heading != blank -%}
		<header class="header off">
			<h2 class="h6 title">{{ section.settings.heading | escape }}</h2>
		</header>
	{%- endif -%}

	<tab-container class="tabs">
		<tab-controls x-flex wrap="wrap" role="radiogroup" aria-label="{{ 'openthinking.dictionary.word.collections' | t | escape }}">
			{%- for block in section.blocks -%}
                {% liquid
					assign selected_collection = block.settings.product_list
					assign tab_title = selected_collection.title | default: collections.all.title
					if block.settings.title != blank
						assign tab_title = block.settings.title
					endif
				-%}
				<label class="button is-custom">
					<input
						class="visually-hidden"
						type="radio"
						name="collectionTabs-{{ section.id }}"
						value="{{ forloop.index }}"
						{% if forloop.first %}checked{% endif %}
					>
					<span>{{ tab_title | escape }}</span>
				</label>
			{%- endfor -%}
		</tab-controls>

		{%- for block in section.blocks -%}
			<tab-content data-index="{{ forloop.index }}" class="collectionsItem" id="collection-{{ block.id }}" {{ block.shopify_attributes }}>
			{%- liquid
				assign selected_collection = block.settings.product_list

				if selected_collection != blank
					assign product_list = selected_collection.products
					assign collectionUrl = selected_collection.url
					assign product_total = selected_collection.all_products_count | plus: 0
				else
					assign product_list = collections.all.products | sort: 'published_at' | reverse
					assign collectionUrl = routes.all_products_collection_url
					assign product_total = collections.all.all_products_count | plus: 0
				endif

				assign product_limit = block.settings.product_limit | plus: 0
				assign url = blank
				assign url_label = blank
				assign nav = false

				capture section_heading
					# Active collection actions
					if product_total != empty and product_total > product_limit
						assign url = block.settings.url | default: collectionUrl
						assign url_label = block.settings.label
					endif
					assign attributes = 'wrap-s="wrap"'
					assign stealth = section.settings.stealthMode
					if layoutType == 'list'
						assign nav = true
					endif

					# Render active collection actions
					if url != blank or nav
						render 'c-section-head', url: url, url_label: url_label, nav: nav, attributes: attributes, stealth: stealth
					endif
				endcapture

				# Render collection body
				render 'c-section-grid', section: section, layoutType: layoutType, products: product_list, products_limit: product_limit, section_heading: section_heading
			-%}
			</tab-content>
		{%- endfor -%}
	</tab-container>
</section>

{% schema %}
{
  "name": "Tabbed collections",
  "max_blocks": 4,
  "disabled_on": { "groups": ["header", "footer", "aside"] },
  "presets": [
    {
      "name": "Tabbed collections",
      "category": "Collections",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ],
  "settings": [
    {
        "type": "header",
        "content": "Header"
    },
    {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Featured collections"
    },
    {
        "type": "checkbox",
        "id": "stealthMode",
        "label": "Show header on hover - desktop",
        "default": false
    },
    {
        "type": "select",
        "id": "layoutType",
        "label": "Layout",
        "default": "list",
        "options": [
            { "value": "list", "label": "List" },
            { "value": "grid", "label": "Grid" }
        ]
    },
    {
        "type": "select",
        "id": "card_grid_columns",
        "label": "Columns - desktop",
        "default": "5",
        "visible_if": "{{ section.settings.layoutType == 'grid' }}",
        "options": [
            {
                "value": "2",
                "label": "2 columns"
            },
            {
                "value": "3",
                "label": "3 columns"
            },
            {
                "value": "4",
                "label": "4 columns"
            },
            {
                "value": "5",
                "label": "5 columns"
            },
            {
                "value": "6",
                "label": "6 columns"
            }
        ]
    },
    {
        "type": "select",
        "id": "card_grid_columns_m",
        "label": "Columns - tablet",
        "default": "3",
        "visible_if": "{{ section.settings.layoutType == 'grid' }}",
        "options": [
            {
                "value": "2",
                "label": "2 columns"
            },
            {
                "value": "3",
                "label": "3 columns"
            },
            {
                "value": "4",
                "label": "4 columns"
            }
        ]
    },
    {
        "type": "select",
        "id": "card_grid_columns_s",
        "label": "Columns - mobile",
        "default": "2",
        "visible_if": "{{ section.settings.layoutType == 'grid' }}",
        "options": [
            {
                "value": "1",
                "label": "1 column"
            },
            {
                "value": "2",
                "label": "2 columns"
            }
        ]
    },
	{
		"type": "range",
		"label": "Gap - desktop",
		"id": "card_grid_gap",
		"min": 0,
		"max": 30,
		"step": 1,
		"default": 3,
        "visible_if": "{{ section.settings.layoutType == 'grid' }}"
	},
	{
		"type": "range",
		"label": "Gap - mobile",
		"id": "card_grid_gap_s",
		"min": 0,
		"max": 30,
		"step": 1,
		"default": 2,
        "visible_if": "{{ section.settings.layoutType == 'grid' }}"
	},
    {
        "type": "checkbox",
        "id": "useLocalCardSize",
        "label": "Override global card size",
        "info": "Will override global card size if enabled.",
        "default": false,
        "visible_if": "{{ section.settings.layoutType == 'list' }}"
    },
    {
        "type": "range",
        "label": "Card size",
        "id": "card_size",
        "min": 200,
        "max": 600,
        "step": 10,
        "unit": "px",
        "default": 250,
        "visible_if": "{{ section.settings.useLocalCardSize }}"
    },
    {
        "type": "header",
        "content": "Spacing"
    },
    {
        "type": "range",
        "id": "marginTop",
        "label": "Margin top",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 2
    },
    {
        "type": "range",
        "id": "marginBottom",
        "label": "Margin bottom",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 2
    },
    {
        "type": "range",
        "id": "paddingTop",
        "label": "Padding top",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 2
    },
    {
        "type": "range",
        "id": "paddingBottom",
        "label": "Padding bottom",
        "min": 0,
        "max": 30,
        "step": 1,
        "default": 2
    },
    {
        "type": "header",
        "content": "Appearance"
    },
    {
        "type": "checkbox",
        "id": "global_color_scheme",
        "label": "Use global color scheme",
        "default": true
    },
    {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "coretex-1",
        "visible_if": "{{ section.settings.global_color_scheme == false }}"
    }
  ],
    "blocks": [
      {
        "type": "collection",
        "name": "Collection",
        "settings": [
            {
                "type": "collection",
                "id": "product_list",
                "label": "Featured collection",
                "info": "By default the latest products are shown."
            },
            {
                "type": "text",
                "id": "title",
                "label": "Title",
                "info": "Defaults to the collection title."
            },
            {
                "type": "range",
                "id": "product_limit",
                "label": "Number of products",
                "min": 5,
                "max": 40,
                "step": 5,
                "default": 20
            },
            {
                "type": "url",
                "id": "url",
                "label": "URL"
            },
            {
                "type": "text",
                "id": "label",
                "label": "Label",
                "default": "View all"
            }
        ]
      }
    ]
}
{% endschema %}
