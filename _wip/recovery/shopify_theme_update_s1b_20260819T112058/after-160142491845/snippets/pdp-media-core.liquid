{% doc %}
Renders one product media item.

@param {product} product - Product whose media is rendered.
@param {section} section - Product section settings.
@param {media} media - Product media to render.
@param {number} media_index - One-based position of the media in the visible gallery.
@param {boolean} muted - Whether video starts muted.
@param {boolean} loop - Whether video loops.
@param {boolean} autoplay - Whether video starts automatically.
@param {boolean} controls - Whether video controls are visible.
@param {boolean} imageZoom - Whether image zoom is enabled.
@param {boolean} xr_button - Whether to render the augmented reality button.
@param {string} fetchpriority - Image fetch priority.
@param {boolean} preload - Whether to preload the image.
@param {string} media_alt - Accessible media description.
{% enddoc %}

{%- liquid
    # Image widths
    assign widths = '550,750,950,1280,1426,1646,1946'
    assign sizes = '(min-width: 2720px) 25.36vw, (min-width: 2340px) 30vw, (min-width: 780px) 33.05vw, 37.39vw"'

    # Video
    assign videoLoop = loop
    assign videoAutoplay = autoplay
    assign videoControls = controls
    assign videoMuted = muted
    assign clickToPlay = true
-%}

{%- if media.media_type == 'image' -%}

{%- comment -%}
    Images
{%- endcomment -%}

    {%- if imageZoom -%}
    <button class="is-blank" data-open="#imagezoom-{{ section.id }}-Box" data-zoom-target="{{ section.id }}-{{ media.id }}">
    <span class="visually-hidden">{{ 'products.product.media.open_media' | t: index: media_index }}</span>
    {%- endif -%}

    {%- liquid
        assign img = media.preview_image
        assign widths = widths
        assign sizes = sizes
        assign alt = media_alt | default: product.title
        assign mediaLoader = true

        render 'inc-img' img: img, widths: widths, sizes: sizes, alt: alt, mediaLoader: mediaLoader, fetchpriority: fetchpriority, preload: preload
    -%}

    {%- if imageZoom -%}</button>{%- endif -%}

{%- else -%}

{%- comment -%}
    Video & 3D model
{%- endcomment -%}

{%- if media.media_type == 'model' -%}
    <product-model class="deferred-media media xmodel no-js-hidden" data-media-id="{{ media.id }}" x-grid columns="stack" pi="center">
{%- else -%}
    <deferred-media class="deferred-media media xvideo no-js-hidden" data-media-id="{{ media.id }}" x-grid columns="stack" pi="center">
{%- endif -%}

{%- comment -%}
    When video is autoplay
{%- endcomment -%}

{% if media.media_type == 'video' and videoAutoplay == true %}

	{%- render 'inc-video'
        vid: media, 
        loop: videoLoop, 
        autoplay: videoAutoplay, 
        controls: videoControls, 
        muted: videoMuted,
        clickToPlay: clickToPlay
	-%}

{% else %}

    <button id="Deferred-Poster-Modal-{{ media.id }}" type="button" x-grid columns="stack" pi="center">
        <poster-button>
        {%- liquid 
            if media.media_type == 'model' 
                render 'inc-icon', icon: 'cube'
            else
                render 'inc-icon', icon: 'os-play'
            endif
        -%}
        </poster-button>

        {%- liquid 
            assign img = media.preview_image
            assign width = 1946
            assign widths = widths
            assign sizes = sizes
            assign alt = media_alt | default: product.title
            assign mediaLoader = true
    
            render 'inc-img' img: img, width: width, widths: widths, sizes: sizes, alt: alt, mediaLoader: mediaLoader
        -%}
    </button>

    <template>
    {%- liquid
        case media.media_type
        when 'external_video'

            assign video_class = 'js-' | append: media.host
            if media.host == 'youtube'
                echo media | external_video_url: autoplay: true, loop: videoLoop, playlist: media.external_id | external_video_tag: class: video_class, loading: "lazy"
            else
                echo media | external_video_url: autoplay: true, loop: videoLoop | external_video_tag: class: video_class, loading: "lazy"
            endif

        when 'video'
            echo media | media_tag: image_size: "2048x", autoplay: true, loop: videoLoop, muted: videoMuted, controls: false, preload: "none"
        when 'model'
            echo media | media_tag: image_size: "2048x", toggleable: true
        endcase
    -%}
    </template>
{% endif %}

    {%- if media.media_type == 'model' -%}
    </product-model>
    {%- if xr_button -%}
        <div class="d3xr-button">
            <button type="button" class="has-icon xr-button"
                data-shopify-xr data-shopify-model3d-id="{{ media.id }}" 
                data-shopify-title="{{ product.title | escape }}" 
                data-shopify-xr-hidden>
                <span>{% render 'inc-icon', icon: 'cube' %}</span>
                <small class="text-normal">{{ 'products.product.xr_button' | t }}</small>
            </button>
          </div>
    {%- endif -%}
    {%- else -%}
    </deferred-media>
    {%- endif -%}
{%- endif -%}
