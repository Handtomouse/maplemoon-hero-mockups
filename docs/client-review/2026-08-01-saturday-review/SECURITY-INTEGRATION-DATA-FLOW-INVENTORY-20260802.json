      "purpose": "establish catalogue truth in a test environment",
      "state": "BLOCKED_INPUTS",
      "required_controls": ["hash/provenance", "PII exclusion", "formula/markup safety", "conflict report", "dry run", "backup", "rollback"]
    },
    {
      "id": "FLOW-SHOPIFY-STOREFRONT",
      "source": "customer browser",
      "destination": "future Shopify storefront",
      "data_categories": ["storefront requests", "native cart state", "approved customer events if enabled"],
      "purpose": "serve the production storefront and native cart",
      "state": "HOLD",
      "required_controls": ["named roles and 2FA", "development-theme UAT", "privacy/consent", "minimal scripts/apps", "security headers", "monitoring", "rollback"]
    },
    {
      "id": "FLOW-SHOPIFY-CHECKOUT",
      "source": "native Shopify cart",
      "destination": "native Shopify checkout and approved payment/shipping/tax services",
      "data_categories": ["order and customer data required by native checkout"],
      "purpose": "complete real commerce",
      "state": "HOLD",
      "required_controls": ["store owner approval", "payments/shipping/tax/policy configuration", "test-mode UAT", "least privilege", "notifications", "incident and rollback plan"]
    },
    {
      "id": "FLOW-CONTACT-EMAIL",
      "source": "future approved contact/newsletter form",
      "destination": "future approved Shopify/email/CRM recipient",
      "data_categories": ["minimum approved contact or subscription fields"],
      "purpose": "answer enquiries or manage separately consented subscriptions",
      "state": "HOLD",
      "required_controls": ["provider/recipient approval", "consent", "double opt-in decision", "spam control", "suppression", "retention", "export/deletion"]
    },
    {
      "id": "FLOW-STOCKISTS",
      "source": "approved stockist directory owner",
      "destination": "future approved structured storefront source",
      "data_categories": ["minimum verified business listing fields"],
      "purpose": "power the stockist finder",
      "state": "HOLD",
      "required_controls": ["provenance", "business-only fields", "update cadence", "access", "correction/removal route", "rendered QA"]
