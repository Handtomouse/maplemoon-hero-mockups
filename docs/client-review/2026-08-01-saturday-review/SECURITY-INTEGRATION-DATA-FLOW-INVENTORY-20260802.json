  "prospective_flows": [
    {
      "id": "FLOW-REVIEW-HOST",
      "source": "approved reviewer browser",
      "destination": "future approved review host",
      "data_categories": ["page requests", "coarse operational access logs if the host cannot disable them"],
      "purpose": "deliver the clean review artifact",
      "state": "HOLD",
      "required_controls": ["exact audience", "HTTPS", "access and expiry", "route allowlist", "log minimisation", "revocation", "forwardability test"]
    },
    {
      "id": "FLOW-FEEDBACK",
      "source": "review feedback form",
      "destination": "future approved feedback service and owner",
      "data_categories": ["page", "visible section", "coarse device family", "feedback type", "optional concise comment"],
      "purpose": "collect separately approved review feedback",
      "state": "HOLD",
      "required_controls": ["notice and consent disposition", "minimum fields", "spam/abuse control", "access list", "retention", "deletion", "export", "no sensitive-text request"]
    },
    {
      "id": "FLOW-SOFT-LAUNCH-EVENTS",
      "source": "future approved first-party test instrumentation",
      "destination": "future approved test-data store",
      "data_categories": ["approved event allowlist", "coarse cohort/device/browser", "test_run_id", "test_data=true"],
      "purpose": "answer named Q1-Q5 soft-launch questions",
      "state": "HOLD",
      "required_controls": ["event/property allowlist", "no production mixing", "no full IP/user agent/fingerprint", "notice", "access", "short retention", "disable/delete test"]
    },
    {
      "id": "FLOW-WOO-IMPORT",
